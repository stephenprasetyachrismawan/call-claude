# === Wajib ===
# Token bot dari https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# User ID Discord kamu (aktifkan Developer Mode, klik kanan nama -> Copy User ID).
# Bot HANYA mendengar dan menjawab user ini.
OWNER_USER_ID=
# Server (guild) pribadi tempat bot dipakai
GUILD_ID=

# === Claude (pakai langganan Claude Pro/Max kamu) ===
# Login sekali di laptop: jalankan `claude` lalu ketik /login.
# Bot sengaja MENGHAPUS ANTHROPIC_API_KEY dari environment Claude supaya selalu pakai langganan.
# Opsional: token dari `claude setup-token`, kalau tidak mau bergantung pada login interaktif.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5-5
ORCHESTRATOR_MODEL=claude-sonnet-5-5
# bypass  = Claude menjalankan semua perintah di folder mana pun tanpa bertanya (default)
# confirm = aksi berisiko (hapus, install, shutdown, dll.) harus diizinkan dulu
PERMISSION_MODE=bypass
# Nyalakan Remote Control untuk sesi bot, supaya Claude bisa mengirim pesan ke sesi Claude
# kamu yang lain (termasuk server yang menjalankan `claude rc`). Isi false untuk mematikan.
REMOTE_CONTROL=true
# Opsional: sesi Claude Code di server lain yang jalan di dalam tmux (misalnya sesi `claude rc`).
# Ucapkan "sambungkan ke server" untuk bicara dengannya, "kembali ke laptop" untuk kembali.
# SERVER_SSH = nama host di ~/.ssh/config (login pakai SSH key, tanpa password)
SERVER_SSH=
# Nama sesi tmux tempat Claude berjalan di server (lihat `tmux ls`)
SERVER_TMUX=
SERVER_NAME=server
# Folder awal Claude saat mulai bekerja
WORKSPACE_DIR=C:\Users\NAMA\Documents\claude-workspace

# === Opsional ===
# Channel teks untuk transkrip, jawaban lengkap, dan tombol konfirmasi.
# Kosong = pakai chat bawaan voice channel.
TEXT_CHANNEL_ID=
# Speech-to-text lokal (Whisper di laptop, tanpa API key). Model diunduh sekali ke folder models/.
# Bahasa yang kamu ucapkan (kode ISO-639-1)
STT_PROVIDER=gemini
GEMINI_CLI=gemini
GEMINI_MODEL=
STT_LANGUAGE=id
# Lebih akurat tapi lebih lambat: onnx-community/whisper-large-v3-turbo
STT_MODEL=onnx-community/whisper-small
STT_DTYPE=q8
# Suara Edge TTS. Pria: id-ID-ArdiNeural
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=+10%
# Jeda diam (ms) yang dianggap akhir kalimat
SILENCE_MS=1000
# Batas waktu menunggu konfirmasi aksi berisiko (detik)
CONFIRM_TIMEOUT_S=60
